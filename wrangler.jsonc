{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "central-chamados",
  "main": "deploy/worker.ts",
  "compatibility_date": "2026-09-22",
  "compatibility_flags": ["nodejs_compat"],
  "containers": [{"class_name": "LaravelContainer", "image": "./Dockerfile", "max_instances": 1, "instance_type": "basic"}],
  "durable_objects": {"bindings": [{"name": "LARAVEL", "class_name": "LaravelContainer"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["LaravelContainer"]}],
  "observability": {"enabled": true},
  "vars": {"APP_URL": "https://configure-before-deploy.invalid", "DB_HOST": "configure-session-pooler.invalid", "DB_USERNAME": "postgres", "DB_PORT": "5432", "DB_DATABASE": "postgres", "DB_SCHEMA": "chamados"}
}
