APP_NAME="Central de Chamados"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-project.vercel.app
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
TRUST_PROXY=true
DB_CONNECTION=pgsql
DB_HOST=your-session-pooler-host
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=chamados_runtime.your-project-ref
DB_PASSWORD=
DB_SCHEMA=chamados
DB_SSLMODE=require
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
SESSION_ENCRYPT=true
CACHE_STORE=array
QUEUE_CONNECTION=sync
LOG_CHANNEL=stderr
LOG_LEVEL=warning
