{
  "name": "chamados",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write resources/",
    "test:e2e": "playwright test",
    "cf:types": "wrangler types",
    "cf:typecheck": "wrangler types && tsc -p deploy/tsconfig.json",
    "cf:deploy": "wrangler deploy"
  },
  "dependencies": {
    "@cloudflare/containers": "^0.3.7",
    "@inertiajs/vue3": "^2.0",
    "@lucide/vue": "^1.47.0",
    "vue": "^3.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.0",
    "@types/node": "^26.6.2",
    "@vitejs/plugin-vue": "^6.0",
    "concurrently": "^9.0",
    "eslint": "^10.11.0",
    "eslint-plugin-vue": "^10.0",
    "laravel-vite-plugin": "^2.0",
    "prettier": "^3.0",
    "tailwindcss": "^4.0",
    "typescript": "^5.9",
    "typescript-eslint": "^8.0",
    "vite": "^7.0",
    "vue-tsc": "^3.0",
    "wrangler": "^4.136.1"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
