APP_NAME="Central de Chamados"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug
DB_CONNECTION=sqlite
SESSION_DRIVER=file
SESSION_LIFETIME=30
SESSION_EXPIRE_ON_CLOSE=true
QUEUE_CONNECTION=sync
CACHE_STORE=file
MAIL_MAILER=log
VITE_APP_NAME="${APP_NAME}"
